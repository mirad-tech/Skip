<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Skip">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Skip" />

        <activity-alias
            android:name=".icon.SkyBlueIcon"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_sky_blue"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_sky_blue"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".icon.MintGreenIcon"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_mint_green"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_mint_green"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".icon.VioletGlowIcon"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_violet_glow"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_violet_glow"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".icon.SunsetOrangeIcon"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_sunset_orange"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_sunset_orange"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".icon.CherryPinkIcon"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_cherry_pink"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_cherry_pink"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".icon.ObsidianGoldIcon"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_obsidian_gold"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_obsidian_gold"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <service
            android:name=".service.SkipAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>

            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>

</manifest>
