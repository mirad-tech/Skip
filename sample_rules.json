{
  "schemaVersion": 3,
  "name": "Skip 安全精确规则示例",
  "version": 1,
  "author": "local",
  "updateTime": "2026-07-21",
  "description": "仅演示已有稳定 Activity 与完整 View ID 证据的精确规则。",
  "apps": [
    {
      "packageName": "com.duowan.kiwi",
      "appName": "虎牙直播",
      "rules": [
        {
          "id": "sample_precise_com.duowan.kiwi_second_splash",
          "kind": "precise",
          "name": "虎牙第二开屏跳过示例",
          "activityName": "com.duowan.kiwi.adsplash.view.SecondAdSplashActivity",
          "matchTexts": ["跳过"],
          "matchContentDescriptions": [],
          "matchViewIds": ["com.duowan.kiwi:id/skip_time"],
          "textMatchMode": "exact",
          "contentDescriptionMatchMode": "exact",
          "viewIdMatchMode": "exact",
          "area": "top_right",
          "action": "click",
          "priority": 300,
          "cooldownMs": 1500,
          "validDurationMs": 15000,
          "minScore": 70,
          "coordinateFallback": {
            "enabled": false,
            "xRatio": 0.9,
            "yRatio": 0.12
          }
        }
      ]
    }
  ]
}
