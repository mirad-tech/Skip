{
  "schemaVersion": 2,
  "name": "Skip 本地低风险示例规则包",
  "version": 1,
  "author": "local",
  "updateTime": "2026-05-14",
  "description": "示例仅用于开屏页面助手场景，不包含高风险按钮，不启用坐标兜底。",
  "appPolicies": [
    {
      "packageName": "com.example.app",
      "defaultRuleEnabled": true,
      "customRulesEnabled": true
    }
  ],
  "apps": [
    {
      "packageName": "com.example.app",
      "appName": "示例 App",
      "rules": [
        {
          "id": "sample_opening_page_skip",
          "name": "开屏页面跳过控件",
          "enabled": true,
          "activityName": "*",
          "matchTexts": ["跳过", "关闭", "以后再说"],
          "matchContentDescriptions": ["跳过", "关闭"],
          "matchViewIds": ["skip", "close"],
          "textMatchMode": "contains",
          "contentDescriptionMatchMode": "contains",
          "viewIdMatchMode": "contains",
          "area": "top_right",
          "action": "click",
          "priority": 10,
          "cooldownMs": 1200,
          "validDurationMs": 6000,
          "minScore": 72,
          "coordinateFallback": {
            "enabled": false,
            "xRatio": 0.9,
            "yRatio": 0.12,
            "anchorTexts": ["开屏提示"]
          }
        }
      ]
    }
  ]
}
